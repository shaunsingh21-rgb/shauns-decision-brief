# Copy to .env and fill in. NEVER commit .env. Keys are only ever read on the server.
NODE_ENV=production
PORT=3000
# 1 when running behind Caddy/nginx (the Docker setup does this for you)
TRUST_PROXY=1
# Where the database and uploaded files live (back this folder up, or use npm run backup)
DB_PATH=./data/avl-hub.db
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Optional: a second place to copy each nightly backup (a mounted network share, for example)
BACKUP_COPY_TO=
# Your SharePoint host(s), comma separated. Strongly recommended, e.g. yourorg.sharepoint.com
SHAREPOINT_HOSTS=
# Optional two-step sign-in (authenticator app). Leave blank to keep the feature off.
# To turn it on, make a key with:  openssl rand -hex 32   and paste the 64 characters here.
# KEEP A COPY OF THIS KEY IN YOUR PASSWORD MANAGER. It is deliberately NOT in backups. Without it, nobody can use authenticator codes
# (recovery codes still work, and an administrator can reset people).
MFA_ENCRYPTION_KEY=
# Optional features (leave blank to keep them off)
BRAVE_API_KEY=
ANTHROPIC_API_KEY=
# Limits (defaults shown)
MAX_PHOTO_MB=10
MAX_DOC_MB=20
MAX_VIDEO_MB=200
SESSION_TTL_HOURS=12
LOCKOUT_MAX_FAILURES=5
LOCKOUT_MINUTES=15
# Only used by Docker Compose / Caddy for automatic HTTPS
DOMAIN=

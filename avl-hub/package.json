{
  "name": "avl-hub",
  "version": "0.2.0",
  "private": true,
  "description": "AVL Tech Training & Equipment Hub (ITS Events, Moody Bible Institute)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-timeout=60000 --test-concurrency=1 \"test/api/**/*.test.js\"",
    "postinstall": "node scripts/vendor-ocr.js",
    "vendor-ocr": "node scripts/vendor-ocr.js",
    "test:e2e": "node --test --test-timeout=60000 --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "zod": "^4.6.7"
  }
}